rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function image() { return request.resource.contentType.matches('image/.*'); }
    function under5MB() { return request.resource.size < 5 * 1024 * 1024; }
    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && image() && under5MB();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /organs/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && image() && under5MB();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /events/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid && image() && under5MB();
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
